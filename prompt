#! /usr/bin/env bash
#-------------------------------------------------------------------------------
# File        : .prompt
# Author      : Lewis Russell
# Description : bash/zsh prompt for seamless use with Git
#-------------------------------------------------------------------------------

# The prompt will check the git config for branch.<branch>.upstream
# for a branch this branch aims to be merged into, e.g:
#
# ```
# git config branch.mybranch.upstream upstream/main
# ```

SHELL="$1"
RET_CODE="$2"
FAST="$3"
CMD_TIME="$4"
TMUX_TARGET_WIN="$5"
TMUX_TARGET_CAPTURED="$6"

#-------------------------------------------------------------------------------
# Init
#-------------------------------------------------------------------------------
# Unalias all aliases
unalias -a

#-------------------------------------------------------------------------------
# Globals
#-------------------------------------------------------------------------------
CHECKOUT=""
CHECKOUT_NAME=""
CHECKOUT_IS_TAG=0
FCP_GIT_DIR=""
FCP_GIT_COMMON_DIR=""
FCP_GIT_ROOT=""
FCP_GIT_PREFIX=""
STATUS_HEAD=""
STATUS_OID=""
STATUS_UPSTREAM=""
STAGED_CHANGED=""
STAGED_ADDED=""
STAGED_DELETED=""
CONFLICTS=""
UNSTAGED_CHANGED=""
UNSTAGED_DELETED=""
UNTRACKED=""
STASHES=""
SUBMODULE_UNSYNC=""
SUBMODULE_UNINIT=""
LOCAL_BRANCHES=""

#-------------------------------------------------------------------------------
# Attributes, Colours & Constants
#-------------------------------------------------------------------------------
if [ "$SHELL" == "bash" ]; then
    C_START='\['
    C_END='\]'
    P_USER='\u'
    P_HOST='\H'
elif [ "$SHELL" == "zsh" ]; then
    C_START='%{'
    C_END='%}'
    P_USER='%n'
    P_HOST='%m'
else
    printf 'Unsupported shell: %s (expected bash or zsh)\n' "$SHELL" >&2
    exit 1
fi

# reverse="${c_start}\\e[3;35m${c_end}"
# underlined="${c_start}\\e[4;35m${c_end}"
# dim="${c_start}\\e[10;35m${c_end}"
# Emit colours directly so shell hooks need not decode backslashes in names.
GRAY="$C_START"$'\e[0;90m'"$C_END"
RED="$C_START"$'\e[0;31m'"$C_END"
GREEN="$C_START"$'\e[0;32m'"$C_END"
YELLOW="$C_START"$'\e[0;33m'"$C_END"
BLUE="$C_START"$'\e[0;34m'"$C_END"
MAGENTA="$C_START"$'\e[0;35m'"$C_END"
CYAN="$C_START"$'\e[0;36m'"$C_END"
WHITE="$C_START"$'\e[0;37m'"$C_END"
END="$C_START"$'\e[0m'"$C_END" # This is needed at the end.

# Emit an OSC-133;A sequence before each prompt.
if [ "$SHELL" == "zsh" ]; then
    OSC133_START="\e]133;A\e\\"
else
    OSC133_START=""
fi

#-------------------------------------------------------------------------------
# Configuration
#-------------------------------------------------------------------------------
# FANCY_PROMPT_TIMEOUT

# FANCY_PROMPT_USE_SYMBOLS
#     NOTE: this is a multi-char symbol which causes glitches with zsh tab
#     completion. e.g. vim <tab> if locale is not setup correctly.
#     export LC_CTYPE=en_US.UTF-8

#-------------------------------------------------------------------------------
# Functions
#-------------------------------------------------------------------------------
var_enabled() {
    [[ -n "$1" && "$1" != 0 ]]
}

check_command() {
    command -v "$1" &> /dev/null
}

convertsecs() {
    d=$((${1} / 86400))
    h=$((${1} % 86400 / 3600))
    m=$((${1} % 3600 / 60))
    s=$((${1} % 60))
    if ((d!=0)); then
        printf "%dd %dh %dm %ds" "$d" "$h" "$m" "$s"
    elif ((h!=0)); then
        printf "%dh %dm %ds" "$h" "$m" "$s"
    elif ((m!=0)); then
        printf "%dm %ds" "$m" "$s"
    else
        printf "%ds" "$s"
    fi
}

read_git_paths() {
    local info
    # Metadata and bare repositories have no --show-toplevel. Git still returns
    # the preceding fields, which let the caller handle those directories.
    info=$(git rev-parse --path-format=absolute --is-inside-git-dir --is-bare-repository \
        --git-dir --git-common-dir --show-toplevel --show-prefix 2> /dev/null)
    {
        IFS= read -r FCP_INSIDE_GITDIR
        IFS= read -r FCP_BARE
        IFS= read -r FCP_GIT_DIR
        IFS= read -r FCP_GIT_COMMON_DIR
        IFS= read -r FCP_GIT_ROOT
        IFS= read -r FCP_GIT_PREFIX || :
    } <<< "$info"
}

set_git_checkout() {
    local checkout=$STATUS_HEAD
    if [[ $checkout == "(detached)" ]]; then
        checkout=HEAD
    fi

    # Missing optional config values return 1.
    # Use [ ] for these status checks so Bash 3.2 honors errexit on failure.
    local remote upstream counts
    remote=$(git config --get branch."$checkout".remote) || [ "$?" -eq 1 ]
    upstream=$(git config --get branch."$checkout".upstream) || [ "$?" -eq 1 ]

    if [[ -z $upstream ]]; then
        local gh_resolved
        gh_resolved=$(git config --get remote.upstream.gh-resolved) || [ "$?" -eq 1 ]
        if [[ -n $gh_resolved ]]; then
            upstream=$(git symbolic-ref --quiet --short refs/remotes/upstream/HEAD 2> /dev/null) || [ "$?" -eq 1 ]
        fi
    fi

    if [[ -n $upstream && "$remote/$checkout" != "$upstream" && $STATUS_OID != "(initial)" ]]; then
        if [[ $upstream == "$STATUS_UPSTREAM" ]]; then
            COMMITS_BEHIND_UPSTREAM=$COMMITS_BEHIND
            COMMITS_AHEAD_UPSTREAM=$COMMITS_AHEAD
        else
            counts=$(git rev-list --left-right --count "$upstream"...HEAD)
            read -r COMMITS_BEHIND_UPSTREAM COMMITS_AHEAD_UPSTREAM <<< "$counts"
        fi
        CHECKOUT_UPSTREAM="$upstream"
    fi


    local push_branch=""
    if [[ -n $STATUS_UPSTREAM ]]; then
        push_branch=${STATUS_UPSTREAM#"$remote/"}
    elif [[ -n $remote ]]; then
        local merge
        merge=$(git config --get branch."$checkout".merge) || [ "$?" -eq 1 ]
        push_branch=${merge#refs/heads/}
    fi

    CHECKOUT=$checkout

    if [[ "$CHECKOUT" == HEAD ]]; then
        local tag

        # Show short hash if not on a branch
        CHECKOUT=$(git rev-parse --short HEAD)

        if [[ -d "$FCP_GIT_DIR/rebase-merge" || -d "$FCP_GIT_DIR/rebase-apply" ]]; then
            # Are we rebasing?
            CHECKOUT="$CHECKOUT(rebasing)"
        elif [[ -f "$FCP_GIT_DIR/BISECT_START" ]]; then
            # Are we bisecting?
            CHECKOUT="$CHECKOUT(bisecting)"
        elif tag=$(git describe --candidates=1 --exact-match 2> /dev/null); then
            CHECKOUT=$tag
            CHECKOUT_IS_TAG=1
        fi
    fi

    CHECKOUT_NAME="$CHECKOUT"

    if [ -n "$push_branch" ]; then
        if [ "$CHECKOUT" != "$push_branch" ]; then
            local tracking_arrow="->"
            if var_enabled "$FANCY_PROMPT_USE_SYMBOLS"; then
                tracking_arrow=" → "
            fi
            CHECKOUT="$CHECKOUT$tracking_arrow$push_branch"
        fi
    elif [[ $CHECKOUT_IS_TAG != 1 ]]; then
        CHECKOUT="$CHECKOUT!"
    fi

    if [[ "$FCP_GIT_DIR" != "$FCP_GIT_COMMON_DIR" ]]; then
        CHECKOUT="[worktree]$CHECKOUT"
    fi
}

parse_porcelain_info() {
    local porcelain_info=$1
    STAGED_CHANGED=0
    STAGED_ADDED=0
    STAGED_DELETED=0
    UNSTAGED_DELETED=0
    UNSTAGED_CHANGED=0
    UNTRACKED=0
    CONFLICTS=0

    local line xy ahead behind
    while IFS= read -r line; do
        case $line in
            '# branch.head '*) STATUS_HEAD=${line#'# branch.head '} ;;
            '# branch.oid '*) STATUS_OID=${line#'# branch.oid '} ;;
            '# branch.upstream '*) STATUS_UPSTREAM=${line#'# branch.upstream '} ;;
            '# branch.ab '*)
                read -r ahead behind <<< "${line#'# branch.ab '}"
                COMMITS_AHEAD=${ahead#+}
                COMMITS_BEHIND=${behind#-}
                ;;
            '# stash '*) STASHES=${line#'# stash '} ;;
            'u '*) ((++CONFLICTS)) ;;
            '? '*) ((++UNTRACKED)) ;;
            [12]' '*)
                xy=${line:2:2}
                case ${xy:0:1} in
                    [MTRC]) ((++STAGED_CHANGED)) ;;
                    A) ((++STAGED_ADDED)) ;;
                    D) ((++STAGED_DELETED)) ;;
                esac
                case ${xy:1:1} in
                    [MTA]) ((++UNSTAGED_CHANGED)) ;;
                    D) ((++UNSTAGED_DELETED)) ;;
                esac
                ;;
        esac
    done <<< "$porcelain_info"
}

set_local_branches() {
    local branches branch upstream remote tracked
    branches=$(git for-each-ref --format='%(refname:strip=2)%09%(upstream)%09%(upstream:remotename)' refs/heads)
    LOCAL_BRANCHES=0
    while IFS=$'\t' read -r branch upstream remote; do
        [[ -n $branch ]] || continue
        tracked=""
        if [[ $upstream == refs/heads/* ]]; then
            tracked=${upstream#refs/heads/}
        elif [[ -n $remote && $upstream == "refs/remotes/$remote/"* ]]; then
            tracked=${upstream#"refs/remotes/$remote/"}
        fi
        if [[ $branch != "$tracked" ]]; then
            ((++LOCAL_BRANCHES))
        fi
    done <<< "$branches"
}

if ! command -v timeout &> /dev/null; then
    timeout() { perl -e 'alarm shift; exec @ARGV' "$@"; }
fi

get_git_info() {
    timeout "$TIMEOUT" git --no-optional-locks status --untracked-files=normal \
        --branch --show-stash --porcelain=v2 --ignore-submodules
}

set_git_info() {
    local info
    info=$(get_git_info)

    parse_porcelain_info "$info"

    # Check actual gitlinks, including when .gitmodules is missing or deleted.
    local entries submodule_info
    entries=$(git ls-files --stage)
    if [[ $entries == 160000\ * || $entries == *$'\n'160000\ * ]]; then
        submodule_info=$(timeout "$TIMEOUT" git submodule status --recursive 2> /dev/null)
        if [[ -n $submodule_info ]]; then
            SUBMODULE_UNSYNC=$(grep -cE '^\+' <<< "$submodule_info") || [ "$?" -eq 1 ]
            SUBMODULE_UNINIT=$(grep -cE '^-'  <<< "$submodule_info") || [ "$?" -eq 1 ]
        fi
    fi

    set_local_branches
    set_git_checkout
}

escape_prompt() {
    local value=$1
    if [[ $SHELL == bash ]]; then
        # Bash decodes prompt escapes before evaluating substitutions.
        value=${value//\\/\\\\\\\\}
        value=${value//\$/\\\\\$}
        value=${value//\`/\\\\\`}
    else
        value=${value//%/%%}
    fi
    printf '%s' "$value"
}

build_section() {
    local colour=$1
    local symbol=$2
    local value=$3
    if [[ $value && $value != 0 ]]; then
        printf '%s%s' "$colour" "$symbol"
        escape_prompt "$value"
    fi
}

get_scm_prompt() (
    set -e -o pipefail

    if ((!FAST)); then
        set_git_info
    fi

    if [[ $CHECKOUT == "" ]]; then
        printf "%s" "$GRAY...$GRAY"
        return
    fi

    local src_ctrl=""
    local co_sym
    local checkout="$CHECKOUT"
    local checkout_prefix=""

    if [[ $checkout == "[worktree]"* ]]; then
        checkout_prefix="[worktree]"
        checkout=${checkout#"[worktree]"}
    fi

    if var_enabled "$FANCY_PROMPT_USE_SYMBOLS"; then
        if [[ $CHECKOUT_IS_TAG == 1 ]]; then
            co_sym=""
        else
            co_sym=""
        fi

        if [[ -n $checkout_prefix ]]; then
            checkout_prefix="󰙅 "
        else
            checkout_prefix="$co_sym"
        fi
    fi

    src_ctrl="$GRAY$checkout_prefix$CYAN$(escape_prompt "$CHECKOUT_NAME")"
    src_ctrl+="$GRAY$(escape_prompt "${checkout#"$CHECKOUT_NAME"}")"
    src_ctrl+=$(build_section " $WHITE"   ↑       "$COMMITS_AHEAD" )
    src_ctrl+=$(build_section " $WHITE"   ↓       "$COMMITS_BEHIND")
    if [[ $CHECKOUT_UPSTREAM != "" ]]; then
        src_ctrl+=" $GRAY("
        src_ctrl+=$(build_section "$GRAY"   "$co_sym" "$CHECKOUT_UPSTREAM"      )
        src_ctrl+=$(build_section " $WHITE"   ↑       "$COMMITS_AHEAD_UPSTREAM" )
        src_ctrl+=$(build_section " $WHITE"   ↓       "$COMMITS_BEHIND_UPSTREAM")
        src_ctrl+="$GRAY)"
    fi
    src_ctrl+=$(build_section " $WHITE"          "$SUBMODULE_UNINIT")
    src_ctrl+=$(build_section " $RED"            "$SUBMODULE_UNSYNC")
    src_ctrl+=$(build_section " $GREEN"   ●       "$STAGED_CHANGED"  )
    src_ctrl+=$(build_section " $GREEN"   +       "$STAGED_ADDED"    )
    src_ctrl+=$(build_section " $GREEN"   -       "$STAGED_DELETED"  )
    src_ctrl+=$(build_section " $RED"     ✖       "$CONFLICTS"       )
    src_ctrl+=$(build_section " $RED"     +       "$UNSTAGED_CHANGED")
    src_ctrl+=$(build_section " $RED"     -       "$UNSTAGED_DELETED")
    # src_ctrl+=$(build_section " $magenta" +        "$UNTRACKED"       )
    src_ctrl+=$(build_section " $MAGENTA" …       "$UNTRACKED"       )
    src_ctrl+=$(build_section " $RED"     ⚑       "$STASHES"         )
    src_ctrl+=$(build_section " $YELLOW"         "$LOCAL_BRANCHES"  )

    if [[ -n $TMUX_TARGET_WIN ]]; then
        local name
        name=${FCP_GIT_ROOT##*/}
        tmux rename-window -t "$TMUX_TARGET_WIN" "$name#[fg=colour8][$CHECKOUT]" || true
    fi

    printf "%s" "$GRAY$src_ctrl$GRAY"
)

get_prompt_arrow() {
    local ret_colour=$1
    local arrow
    if var_enabled "$FANCY_PROMPT_USE_SYMBOLS"; then
        arrow="❯"
    else
        arrow=">"
    fi

    echo "$ret_colour$arrow$END"
}

main() {
  TIMEOUT=${FANCY_PROMPT_TIMEOUT-6}

  if var_enabled "$FANCY_PROMPT_USE_NERD_SYMBOLS"; then
      FANCY_PROMPT_USE_SYMBOLS=1
  fi

  # Zsh captures the target before the slow prompt work starts. If that lookup
  # failed, do not rediscover the active tmux window after the user has moved.
  if [[ -z $TMUX_TARGET_WIN && $TMUX_TARGET_CAPTURED != 1 ]]; then
      if [[ $TMUX_PANE ]]; then
          # Resolve the window from the current pane, then keep that stable id.
          TMUX_TARGET_WIN="$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}')"
      elif [[ $TMUX ]]; then
          # Fallback for shells that do not expose TMUX_PANE.
          TMUX_TARGET_WIN="$(tmux display-message -p '#{window_id}')"
      fi
  fi

  #-------------------------------------------------------------------------------
  # Source Control
  #-------------------------------------------------------------------------------

  local orig_pwd; orig_pwd=$(pwd -P)
  read_git_paths
  local in_gitdir=$FCP_INSIDE_GITDIR
  local in_bare_gitdir=$FCP_BARE
  local metadata_label=""

  if [[ $in_gitdir == true && $in_bare_gitdir != true ]]; then
      local display_root=${FCP_GIT_COMMON_DIR%/.git}
      metadata_label=${orig_pwd##*/}
      if [[ $display_root != "$FCP_GIT_COMMON_DIR" && $orig_pwd == "$display_root/"* ]]; then
          metadata_label="${display_root##*/}/${orig_pwd#"$display_root/"}"
      fi

      local work_tree=$FCP_GIT_ROOT git_file
      if [[ -z $work_tree && -f $FCP_GIT_DIR/gitdir ]]; then
          IFS= read -r git_file < "$FCP_GIT_DIR/gitdir"
          work_tree=${git_file%/*}
      elif [[ -z $work_tree && $FCP_GIT_DIR == */.git ]]; then
          work_tree=${FCP_GIT_DIR%/.git}
      fi
      if [[ -n $work_tree ]]; then
          cd "$work_tree" || exit
          read_git_paths
      fi
  fi

  local in_git=false
  if [[ -n $FCP_GIT_ROOT ]]; then
      in_git=true
  fi

  local prompt_info=""
  if $in_git; then
      # An if/|| around this call would disable errexit inside the helper.
      prompt_info=$(get_scm_prompt)
      # shellcheck disable=SC2181
      if (( $? != 0 )); then
          prompt_info="$GRAY...$GRAY"
      fi
  fi

  local dir
  if [[ $in_bare_gitdir == true ]]; then
      dir=${orig_pwd##*/}
  elif [[ -n $metadata_label ]]; then
      dir=$metadata_label
  elif $in_git; then
      dir="${FCP_GIT_ROOT##*/}/${FCP_GIT_PREFIX%/}"
      dir=${dir%/}
  fi

  if [[ -n $dir ]]; then
      dir=$(escape_prompt "$dir")
  elif [ "$SHELL" == "bash" ]; then
      dir='\W'
  else
      dir='%c'
  fi

  #-------------------------------------------------------------------------------
  # Prompt
  #-------------------------------------------------------------------------------
  local prompt="${BLUE}${P_HOST}:${CYAN}${P_USER}:${GREEN}$dir "

  local ret_colour
  if [ "$RET_CODE" -eq 0 ]; then
      ret_colour="$CYAN"
  else
      ret_colour="$RED"
  fi

  local prompt_time=''
  if [[ $CMD_TIME ]] && ! [[ $CMD_TIME == 0* ]]; then
      prompt_time="$GRAY$(convertsecs "$CMD_TIME")"
  fi

  if ! $in_git && [[ -n $TMUX_TARGET_WIN ]]; then
      tmux rename-window -t "$TMUX_TARGET_WIN" "$(basename "$orig_pwd")"
  fi

  printf "%s\n$OSC133_START%s%s\n" "$prompt_time" "$prompt" "$prompt_info"
  printf "%s " "$(get_prompt_arrow "$ret_colour")"
}

main
